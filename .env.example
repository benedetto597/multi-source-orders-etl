# Copy to .env and adjust. Never commit .env.

# Source database (any SQLAlchemy URL). Default: local synthetic SQLite "legacy" source.
SOURCE_DB_URL=sqlite:///data/source/legacy_source.db
# SQL Server example (requires `pip install -e .[mssql]` and ODBC Driver 18):
# SOURCE_DB_URL=mssql+pyodbc://<user>:<password>@<server>/<database>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes

# Folder with one sub-folder per distribution center (dc_1/, dc_2/) holding orders_YYYYMM.csv files
CSV_DIR=data/csv

# Target SQLite warehouse and reports
TARGET_DB_PATH=data/target/warehouse.db
REPORTS_DIR=reports

# full = truncate + insert (atomic); incremental = watermark-based upsert
ETL_MODE=full
# Re-read this many days before the last watermark to catch late updates
INCREMENTAL_OVERLAP_DAYS=30
ETL_STATE_PATH=data/target/etl_state.json
